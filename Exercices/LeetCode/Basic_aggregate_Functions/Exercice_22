Write a solution to report the fraction of players that logged in again on the day after the day they first logged in, rounded to 2 decimal places. In other words, you need to determine the number of players who logged in on the day immediately following their initial login, and divide it by the number of total players.

My solution :

SELECT ROUND(COUNT(DISTINCT player_id) / (SELECT COUNT(DISTINCT player_id) FROM Activity),2)
FROM (SELECT *, date(event_date, '+1 day') as date_plusone,
ROW_NUMBER() OVER(
    PARTITION BY player_id
    ORDER BY event_date
) player_order
FROM Activity) t
WHERE EXISTS (
    SELECT event_date
    FROM Activity
    WHERE date_plusone = event_date AND t.player_id = Activity.player_id AND player_order = 1
  )

-- Transform date into date_add --

SELECT ROUND(COUNT(DISTINCT player_id) / (SELECT COUNT(DISTINCT player_id) FROM Activity),2) as fraction
FROM (SELECT *, date_add(event_date, INTERVAL 1 DAY) as date_plusone,
ROW_NUMBER() OVER(
    PARTITION BY player_id
    ORDER BY event_date
) player_order
FROM Activity) t
WHERE EXISTS (
    SELECT event_date
    FROM Activity
    WHERE date_plusone = event_date AND t.player_id = Activity.player_id AND player_order = 1
  )

