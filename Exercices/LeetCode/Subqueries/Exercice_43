SELECT Department, Employee, Salary
FROM (
SELECT  d.name as Department, e.name as Employee, e.salary as Salary, DENSE_RANK() OVER (PARTITION BY d.name ORDER BY e.salary DESC) as rank_salary
FROM Employee e
JOIN Department d ON d.id = e.departmentId
ORDER BY department, salary DESC) t1
WHERE rank_salary BETWEEN 1 AND 3


SELECT Department, Employee, Salary
FROM (
SELECT  d.name as Department, e.name as Employee, e.salary as Salary, DENSE_RANK() OVER (PARTITION BY d.name ORDER BY e.salary DESC) as rank_salary
FROM Employee e
JOIN Department d ON d.id = e.departmentId
ORDER BY department, salary DESC) t1
WHERE rank_salary < 4

