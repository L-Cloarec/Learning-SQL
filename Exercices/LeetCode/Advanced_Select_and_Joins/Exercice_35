SELECT person_name
FROM (
SELECT *, LEAD(total_weight) OVER (ORDER BY turn ASC) as poids
FROM (
SELECT *, SUM(weight) OVER (ORDER BY turn ASC) as total_weight
FROM Queue) a ) t
WHERE total_weight <= 1000
  AND (poids > 1000 OR poids IS NULL)

