My solution 2 :

-- Calculate day difference --

SELECT *, lag(temperature) OVER(ORDER BY recordDate) AS previous_date, julianday(recordDate) - julianday(LAG(recordDate) OVER (ORDER BY recordDate)) AS diff_days
FROM Weather2

-- Merge with previous code in My solution 1 --

SELECT id
FROM (
SELECT *, lag(temperature) OVER(ORDER BY recordDate) AS previous_date, julianday(recordDate) - julianday(LAG(recordDate) OVER (ORDER BY recordDate)) AS diff_days
FROM Weather) t
WHERE temperature > previous_date AND diff_days = 1

