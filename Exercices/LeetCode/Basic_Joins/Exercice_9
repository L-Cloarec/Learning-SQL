Table: Weather

-- DB BROWSER for SQLite --

CREATE TABLE IF NOT EXISTS Weather (
	id int,
	recordDate date,
	temperature int);
	
DELETE FROM Weather;

INSERT INTO Weather (id, recordDate, temperature) VALUES 
('1', '2015-01-01', '10'),
('2', '2015-01-02', '25'),
('3', '2015-01-03', '20'),
('4', '2015-01-04', '30');

Write a solution to find all dates' id with higher temperatures compared to its previous dates (yesterday).
Return the result table in any order.

My solution 1 :

-- Global view --

SELECT *
FROM Weather

-- Specific to lag(temperature)

SELECT *, lag(temperature) OVER(ORDER BY recordDate) AS previous_date
FROM Weather

-- Merged --

SELECT id
FROM (
SELECT *, lag(temperature) OVER(ORDER BY recordDate) AS previous_date
FROM Weather) t
WHERE temperature > previous_date

