My solution 2 :

SELECT a.user_id, 
ROUND(AVG(
	CASE 
		WHEN action = 'confirmed' 
		THEN 1 
		ELSE 0 
	END),
	2) as confirmation_rate
FROM Signups a
LEFT JOIN Confirmations b ON a.user_id = b.user_id
GROUP BY a.user_id;

