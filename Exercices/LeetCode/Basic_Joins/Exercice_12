Write a solution to find the number of times each student attended each exam.

Return the result table ordered by student_id and subject_name.

-- Global view --

SELECT *
FROM Students
LEFT JOIN Examinations ON Students.student_id = Examinations.student_id

-- With count --

SELECT Students.student_id, student_name, subject_name, COUNT(subject_name) as attended_exams
FROM Students
LEFT JOIN Examinations ON Students.student_id = Examinations.student_id
GROUP BY student_name, subject_name
ORDER BY Students.student_id, subject_name

-- Do not take into consideration Alex --
-- Global view with CROSS and LEFT JOIN with conditions--

SELECT *
FROM Students
CROSS JOIN Subjects
LEFT JOIN Examinations ON Students.student_id = Examinations.student_id 
AND Examinations.subject_name = Subjects.subject_name

-- Resolution --

SELECT *
FROM Students
CROSS JOIN Subjects
LEFT JOIN Examinations ON Students.student_id = Examinations.student_id 
AND Examinations.subject_name = Subjects.subject_name
GROUP BY Students.student_id, Subjects.subject_name
ORDER BY Students.student_id, Subjects.subject_name

